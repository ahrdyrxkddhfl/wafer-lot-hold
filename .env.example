# .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# PostgreSQL 비밀번호. docker compose(컨테이너 생성)와 mes/db.py(접속)가 함께 읽는다.
# 컨테이너를 이미 띄웠다면 처음 띄울 때 쓴 값과 같아야 한다.
POSTGRES_PASSWORD=

# 아래는 같은 컴퓨터에서 이 저장소를 하나 더 띄울 때만 채운다(비워 두면 기본값).
# DB 호스트 포트(기본 5434). docker compose와 mes/db.py가 함께 읽는다.
# POSTGRES_PORT=5435
# DB 컨테이너 이름(기본 wafer-lot-hold-postgres)
# POSTGRES_CONTAINER=wafer-lot-hold-repro-postgres
# compose 프로젝트 이름. 볼륨 이름이 여기서 정해지므로, 다른 DB를 쓰려면 반드시 바꾼다(기본은 폴더 이름).
# COMPOSE_PROJECT_NAME=wafer-lot-hold-repro
